{
  "name": "dem-desktop",
  "private": true,
  "license": "AGPL-3.0-only",
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "dev": "node scripts/fetch-fonts.ts && vite",
    "build": "node scripts/fetch-fonts.ts --release && tsc -b && vite build",
    "tauri": "tauri",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen:theme": "node scripts/gen-theme.ts",
    "typecheck": "tsc -b --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test",
    "fonts": "node scripts/fetch-fonts.ts",
    "probe:app": "node probe/app.mjs",
    "probe:p2": "node probe/p2.mjs",
    "probe:p3": "node probe/p3.mjs",
    "probe:p4": "node probe/p4.mjs",
    "probe:en": "PROBE_LOCALE=en-US node probe/p5-en.mjs",
    "probe:workspace": "node probe/workspace.mjs",
    "probe:sample": "node probe/sample.mjs",
    "probe:stress": "node probe/stress.mjs",
    "probe:screens": "node probe/screens.mjs",
    "probe:home": "node probe/home.mjs",
    "probe:editor": "node probe/editor.mjs",
    "probe:board": "node probe/board.mjs",
    "probe:launcher": "node probe/launcher.mjs",
    "probe:settings": "node probe/settings.mjs",
    "probe:ai": "node probe/ai.mjs",
    "probe:focus": "node probe/focus.mjs",
    "probe:gallery": "node probe/gallery.mjs",
    "probe:heatmap": "node probe/heatmap.mjs",
    "probe:privacy": "node probe/privacy.mjs",
    "probe:plugins": "node probe/plugins.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "@tauri-apps/plugin-notification": "2.8.0",
    "dockview-react": "^8.6.1",
    "loro-crdt": "1.16.2",
    "loro-prosemirror": "0.4.4",
    "lucide-react": "^1.60.0",
    "mermaid": "12.1.0",
    "pinyin-pro": "3.29.5",
    "prosemirror-commands": "1.7.2",
    "prosemirror-dropcursor": "1.8.4",
    "prosemirror-gapcursor": "1.4.1",
    "prosemirror-history": "1.5.1",
    "prosemirror-inputrules": "1.5.1",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-model": "1.25.12",
    "prosemirror-schema-list": "1.6.0",
    "prosemirror-state": "1.4.4",
    "prosemirror-view": "1.42.9",
    "react": "^19.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "playwright": "1.64.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-wasm": "3.6.0",
    "vitest": "^5.0.5"
  }
}
