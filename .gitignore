# Rust
/target/
**/target/

# Node / frontend
node_modules/
dist/
*.tsbuildinfo
.vite/

# Tauri generated
apps/desktop/src-tauri/gen/

# Test and benchmark output (generated libraries, reports)
/tmp/
*.profraw
/bench-out/
/testdata/generated/

